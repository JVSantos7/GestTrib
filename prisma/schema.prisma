generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum UsoImovel {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  TERRENO
}

enum AcaoAuditoria {
  CRIACAO
  ALTERACAO
  EXCLUSAO
}

model Contribuinte {
  id           String     @id @default(uuid()) @db.Uuid
  tipoPessoa   TipoPessoa @map("tipo_pessoa")
  // CPF (11) ou CNPJ (14), sem máscara. O CNPJ pode conter letras (formato alfanumérico de 2026).
  documento    String     @unique @db.VarChar(14)
  nome         String     @db.VarChar(150)
  email        String?    @db.VarChar(150)
  telefone     String?    @db.VarChar(11)
  cep          String     @db.Char(8)
  logradouro   String     @db.VarChar(150)
  numero       String     @db.VarChar(10)
  complemento  String?    @db.VarChar(60)
  bairro       String     @db.VarChar(80)
  cidade       String     @db.VarChar(80)
  uf           String     @db.Char(2)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  // Exclusão lógica: preenchido quando o contribuinte é excluído.
  excluidoEm   DateTime?  @map("excluido_em") @db.Timestamptz(3)

  imoveis Imovel[]

  @@index([nome])
  @@map("contribuintes")
}

model Imovel {
  id             String       @id @default(uuid()) @db.Uuid
  // Setor (2) + quadra (3) + lote (4) + unidade (3), só dígitos. Exibida como SS.QQQ.LLLL.UUU.
  inscricao      String       @unique @db.Char(12)
  uso            UsoImovel
  // Áreas em m², sempre decimais (nunca float): base do cálculo do IPTU na Fase 4.
  areaTerreno    Decimal      @map("area_terreno") @db.Decimal(12, 2)
  areaConstruida Decimal      @default(0) @map("area_construida") @db.Decimal(12, 2)
  // Endereço dentro do município do sistema; cidade e UF vêm da configuração.
  cep            String       @db.Char(8)
  logradouro     String       @db.VarChar(150)
  numero         String       @db.VarChar(10)
  complemento    String?      @db.VarChar(60)
  bairro         String       @db.VarChar(80)
  // Proprietário. Restrict: o banco recusa apagar de vez um contribuinte que tenha imóveis.
  contribuinteId String       @map("contribuinte_id") @db.Uuid
  contribuinte   Contribuinte @relation(fields: [contribuinteId], references: [id], onDelete: Restrict)
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  // Exclusão lógica: preenchido quando o imóvel é excluído.
  excluidoEm     DateTime?    @map("excluido_em") @db.Timestamptz(3)

  @@index([contribuinteId])
  @@index([logradouro])
  @@map("imoveis")
}

// ---------------------------------------------------------------------------
// Autenticação (Better Auth). Os nomes de models e campos seguem o vocabulário
// da biblioteca, que lê e grava essas tabelas sozinha; no banco ficam em português.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(150)
  // Login do sistema. Único: dois usuários não podem ter o mesmo e-mail.
  email         String    @unique @db.VarChar(150)
  emailVerified Boolean   @default(false) @map("email_verificado")
  image         String?   @map("imagem")
  createdAt     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  // Plugin admin: perfil de acesso e bloqueio do usuário.
  role          String?   @map("perfil") @db.VarChar(30)
  banned        Boolean?  @default(false) @map("bloqueado")
  banReason     String?   @map("motivo_bloqueio")
  banExpires    DateTime? @map("bloqueio_expira_em") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@map("usuarios")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  // Valor sorteado que vai no cookie; quem tem o token "é" o usuário até a sessão expirar.
  token          String   @unique
  expiresAt      DateTime @map("expira_em") @db.Timestamptz(3)
  ipAddress      String?  @map("ip")
  userAgent      String?  @map("navegador")
  userId         String   @map("usuario_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("personificado_por")
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessoes")
}

// Forma de login do usuário. Aqui só existe "credential" (e-mail e senha),
// e o campo password guarda o hash da senha, nunca a senha em si.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("conta_id")
  providerId            String    @map("provedor")
  userId                String    @map("usuario_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expira_em") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expira_em") @db.Timestamptz(3)
  scope                 String?   @map("escopo")
  password              String?   @map("senha_hash")
  createdAt             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([userId])
  @@map("contas")
}

// Códigos temporários (ex.: redefinição de senha), usados pela biblioteca.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @map("identificador")
  value      String   @map("valor")
  expiresAt  DateTime @map("expira_em") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verificacoes")
}

model RegistroAuditoria {
  id         String        @id @default(uuid()) @db.Uuid
  entidade   String        @db.VarChar(50)
  entidadeId String        @map("entidade_id") @db.Uuid
  acao       AcaoAuditoria
  // Retrato dos dados após a ação. O usuário responsável entra na Fase 7 (login/perfis).
  dados      Json
  criadoEm   DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([entidade, entidadeId])
  @@map("registros_auditoria")
}
