# Banco local do docker-compose.yml (dados fictícios, só para desenvolvimento)
DATABASE_URL="postgresql://gesttrib:gesttrib@localhost:5434/gesttrib?schema=public"

# Chave secreta do login: gere a sua com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-por-uma-chave-gerada"
BETTER_AUTH_URL="http://localhost:3000"

# Modo demonstração (portfólio): botões "Entrar como..." na tela de login.
# Deixe desligado num uso real. Depois de ligar, crie as contas com `npm run criar-demo`.
DEMO_HABILITADA="false"
DEMO_SENHA="troque-por-uma-senha-longa"

# Cadastro aberto (portfólio): botão "Criar conta" na tela de login. Quem se cadastra entra
# como Operador (usa o sistema, mas não gerencia usuários nem estorna). Num uso real, deixe "false":
# as contas voltam a ser criadas só pelo administrador.
CADASTRO_ABERTO="false"
